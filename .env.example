# ── Base de datos MySQL local ───────────────────────────────────────────────
# El script de arranque crea esta base si no existe, así que basta con poner
# aquí el nombre que quieras usar (por ejemplo `proyecto` en singular).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root1234
DB_NAME=proyectos

# Carga el portafolio de ejemplo la primera vez. Ponlo en false para arrancar
# con la base vacía (los catálogos se cargan igual).
SEED_DEMO=true

# ── Motor de IA ─────────────────────────────────────────────────────────────
# IA_MODO=real      → llama a la API de OpenAI (requiere OPENAI_API_KEY)
# IA_MODO=simulado  → analista por reglas, sin llamadas ni costo.
#                     Es también el respaldo automático si no hay API key.
IA_MODO=simulado
OPENAI_API_KEY=
# Qué modelo usa cada tipo de análisis (ver src/lib/ai/modelos.ts):
#   OPENAI_MODEL        → análisis pesados: salud_proyecto, cuellos_botella,
#                         match_persona_tarea, patrones_globales, perfil_cv
#   OPENAI_MODEL_TEXTO  → tareas de solo texto: planteamiento_proyecto,
#                         tareas_sugeridas (redacción sobre una descripción)
#   OPENAI_MODEL_BARATO → tareas ligeras y frecuentes: priorizacion_diaria
# Las específicas caen en OPENAI_MODEL si quedan vacías.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MODEL_BARATO=gpt-4.1-mini
OPENAI_MODEL_TEXTO=gpt-5.6-luna
# Esfuerzo para modelos de razonamiento: none, minimal, low, medium, high,
# xhigh o max. Las variables específicas caen en la principal si se omiten.
OPENAI_REASONING_EFFORT=max
OPENAI_REASONING_EFFORT_BARATO=low
OPENAI_REASONING_EFFORT_TEXTO=medium
IA_PROMPT_VERSION=v1

# Nombre de la organización que viaja en el contexto de los análisis.
ORG_NOMBRE=Verde Studio

# Horas que dura en caché un análisis con el mismo hash de payload.
IA_CACHE_HORAS=6

# ── Archivos ────────────────────────────────────────────────────────────────
UPLOADS_DIR=./storage/uploads
