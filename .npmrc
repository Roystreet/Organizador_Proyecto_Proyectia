# MUI y Emotion resuelven algunos peers por búsqueda en el árbol de módulos.
# Con el node_modules estricto de pnpm eso falla, así que se elevan solo esos.
public-hoist-pattern[]=*@emotion/*
public-hoist-pattern[]=*@mui/*
public-hoist-pattern[]=*types*
strict-peer-dependencies=false
auto-install-peers=true
