{
  "name": "organizador-proyectos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/preparar.mjs && next dev",
    "build": "next build",
    "start": "node scripts/preparar.mjs && next start",
    "dev:rapido": "next dev",
    "setup": "node scripts/preparar.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mysql",
